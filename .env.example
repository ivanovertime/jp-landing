# Spotify API credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ARTIST_ID=12TET0GvQuCAO3O1tfwrf4

# YouTube channel URL (supports /c/ or /channel/)
YOUTUBE_CHANNEL_URL=https://www.youtube.com/c/JpJheyPi
# Optional: direct channel ID to skip HTML resolution
YOUTUBE_CHANNEL_ID=

# Google Calendar (public events)
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_ID=
# Optional: IANA time zone passed to the Calendar API (e.g. America/Argentina/Buenos_Aires)
GOOGLE_CALENDAR_TIMEZONE=

# Gate for the ?debug=1 endpoint introspection; required in ALL environments
# (there is no dev bypass) and must be set at build time.
DEBUG_SECRET=

# Feature flag: show the events section (set "true" to enable)
EVENTS_ENABLED=
